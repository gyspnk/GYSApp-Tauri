{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GYSApp",
  "version": "0.1.0",
  "identifier": "id.or.gys.app",
  "build": {
    "frontendDist": "../../web/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm --filter @gys/web dev",
    "beforeBuildCommand": "pnpm --filter @gys/web build"
  },
  "app": {
    "windows": [
      {
        "title": "GYSApp",
        "width": 1200,
        "height": 800,
        "minWidth": 320,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' https://*.workers.dev https://e.gys.or.id; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.ico"]
  }
}
