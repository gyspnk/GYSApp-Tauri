{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GYSApp",
  "version": "0.1.0",
  "identifier": "id.or.gys.app",
  "build": {
    "frontendDist": "../../web/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm --filter @gys/web dev",
    "beforeBuildCommand": "pnpm --filter @gys/web build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "GYSApp",
        "url": "index.html",
        "width": 1200,
        "height": 800,
        "minWidth": 320,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' https://*.workers.dev https://e.gys.or.id wss://e.gys.or.id https://tjc.org https://*.tjc.org https://raw.githubusercontent.com; img-src 'self' data: https://tjc.org https://*.tjc.org https://tjcorguploads.s3.amazonaws.com; media-src 'self' blob:; worker-src 'self' blob:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; script-src 'self' 'wasm-unsafe-eval'"
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["gysapp"]
      },
      "mobile": [
        {
          "host": "gyspnk.github.io",
          "pathPrefix": ["/GYSApp-Tauri/open"]
        }
      ]
    },
    "shell": {
      "open": "https?://.*"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.ico"],
    "windows": {
      "nsis": {
        "compression": "lzma",
        "installerHooks": "../nsis-size-hooks.nsh"
      }
    }
  }
}
